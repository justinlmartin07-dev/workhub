<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkHub.ViewModels"
             x:Class="WorkHub.Views.MainLayout"
             x:DataType="vm:MainLayoutViewModel"
             Shell.NavBarIsVisible="False"
             Title="WorkHub">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <Grid x:Name="RootGrid" RowDefinitions="*,Auto">
        <!-- Main content area -->
        <Grid x:Name="ContentGrid" Grid.Row="0" ColumnDefinitions="*">
            <!-- Left Navigation Rail (wide only) -->
            <Grid x:Name="NavRail" Grid.Column="0" ZIndex="10"
                  WidthRequest="80"
                  BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                  IsVisible="False" Padding="0,8" HorizontalOptions="Start">
                <VerticalStackLayout Spacing="4" VerticalOptions="Start" Padding="6,8">
                    <!-- Tab 0: Customers -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 14"
                            Padding="0" BackgroundColor="Transparent" HorizontalOptions="Fill">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                                         Value="True">
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource SurfaceDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="0" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Padding="0,8">
                            <Label Text="&#x1F465;" FontSize="20" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="Customers" FontSize="10" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tab 1: Jobs -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 14"
                            Padding="0" BackgroundColor="Transparent" HorizontalOptions="Fill">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                                         Value="True">
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource SurfaceDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="1" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Padding="0,8">
                            <Label Text="&#x1F527;" FontSize="20" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="Jobs" FontSize="10" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tab 2: Inventory -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 14"
                            Padding="0" BackgroundColor="Transparent" HorizontalOptions="Fill">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
                                         Value="True">
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource SurfaceDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="2" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Padding="0,8">
                            <Label Text="&#x1F4E6;" FontSize="20" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="Inventory" FontSize="10" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tab 3: Calendar -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 14"
                            Padding="0" BackgroundColor="Transparent" HorizontalOptions="Fill">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
                                         Value="True">
                                <Setter Property="BackgroundColor"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource SurfaceDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="3" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Padding="0,8">
                            <Label Text="&#x1F4C5;" FontSize="20" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="Calendar" FontSize="10" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tab 4: Profile (no selected state, navigates via Shell) -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 14"
                            Padding="0" BackgroundColor="Transparent" HorizontalOptions="Fill">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Padding="0,8">
                            <Label Text="&#x1F464;" FontSize="20" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Label Text="Profile" FontSize="10" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- List Panel -->
            <ContentView x:Name="ListPanel" Grid.Column="0"
                         HorizontalOptions="Fill" VerticalOptions="Fill" />

            <!-- Splitter (wide only, between list and detail; hidden on calendar tab) -->
            <Border x:Name="Splitter" Grid.Column="1" IsVisible="False"
                    StyleId="ResizeHorizontal"
                    StrokeThickness="0" BackgroundColor="Transparent" Padding="0">
                <Border.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnSplitterPanUpdated" />
                </Border.GestureRecognizers>
                <BoxView WidthRequest="2" HorizontalOptions="Center" VerticalOptions="Fill"
                         BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />
            </Border>

            <!-- Detail Panel (wide only, dynamically positioned) -->
            <ContentView x:Name="DetailPanel" Grid.Column="2" IsVisible="False"
                         HorizontalOptions="Fill" VerticalOptions="Fill">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="Select an item to view details"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           FontSize="16" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </ContentView>
        </Grid>

        <!-- Bottom Tab Bar (narrow only) -->
        <Grid x:Name="BottomTabs" Grid.Row="1"
              ColumnDefinitions="*,*,*,*,*" HeightRequest="64"
              BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
              Padding="0">
            <!-- Thin top border line -->
            <BoxView Grid.ColumnSpan="5" HeightRequest="0.5" VerticalOptions="Start"
                     BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />

            <!-- Tab 0: Customers -->
            <Border Grid.Column="0" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                    Margin="6,8" Padding="0" BackgroundColor="Transparent">
                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource SurfaceDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="0" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="&#x1F465;" FontSize="18" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                                         Value="True">
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="Customers" FontSize="10" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=0}"
                                         Value="True">
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Tab 1: Jobs -->
            <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                    Margin="6,8" Padding="0" BackgroundColor="Transparent">
                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource SurfaceDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="1" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="&#x1F527;" FontSize="18" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                                         Value="True">
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="Jobs" FontSize="10" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=1}"
                                         Value="True">
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Tab 2: Inventory -->
            <Border Grid.Column="2" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                    Margin="6,8" Padding="0" BackgroundColor="Transparent">
                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource SurfaceDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="2" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="&#x1F4E6;" FontSize="18" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
                                         Value="True">
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="Inventory" FontSize="10" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=2}"
                                         Value="True">
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Tab 3: Calendar -->
            <Border Grid.Column="3" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                    Margin="6,8" Padding="0" BackgroundColor="Transparent">
                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
                                 Value="True">
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource SurfaceDark}}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="3" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="&#x1F4C5;" FontSize="18" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
                                         Value="True">
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="Calendar" FontSize="10" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding SelectedTabIndex, Converter={StaticResource IndexEqualsConverter}, ConverterParameter=3}"
                                         Value="True">
                                <Setter Property="TextColor"
                                        Value="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Tab 4: Profile (no selected state, navigates via Shell) -->
            <Border Grid.Column="4" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                    Margin="6,8" Padding="0" BackgroundColor="Transparent">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="&#x1F464;" FontSize="18" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                    <Label Text="Profile" FontSize="10" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
