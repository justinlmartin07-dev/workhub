<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkHub.ViewModels"
             xmlns:models="clr-namespace:WorkHub.Models"
             xmlns:controls="clr-namespace:WorkHub.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="WorkHub.Views.JobsListPage"
             x:DataType="vm:JobsListViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8,8,16,4">
            <controls:UserAvatarView Grid.Column="0"
                UserName="{Binding UserName}" PhotoUrl="{Binding UserPhotoUrl}"
                Command="{Binding GoToProfileCommand}" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="Jobs" FontSize="20" FontAttributes="Bold"
                   Margin="8,0,0,0" VerticalOptions="Center" />
            <Border Grid.Column="2" x:Name="SortButton"
                    StrokeThickness="0" Stroke="Transparent" BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 8" Padding="0"
                    WidthRequest="40" HeightRequest="40" VerticalOptions="Center"
                    SemanticProperties.Description="Sort jobs"
                    controls:RippleEffect.Enable="True">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSortTapped" />
                </Border.GestureRecognizers>
                <!-- Material Symbols "sort" -->
                <shapes:Path Data="M120-240v-80h240v80H120Zm0-200v-80h480v80H120Zm0-200v-80h720v80H120Z"
                             Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                             Aspect="Uniform" WidthRequest="20" HeightRequest="20"
                             HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <SearchBar Grid.Row="1" Placeholder="Search jobs..." Text="{Binding SearchText}"
                   SearchCommand="{Binding SearchCommand}" Margin="8,0,8,0" />

        <controls:DataStateView x:Name="ListStateView" Grid.Row="2"
            IsLoading="{Binding IsLoading}" HasError="{Binding HasError}" IsEmpty="{Binding IsEmpty}"
            HasContent="{Binding HasContent}" ErrorMessage="{Binding ErrorMessage}"
            EmptyMessage="No jobs found" RetryCommand="{Binding LoadJobsCommand}">
            <controls:DataStateView.Body>
                <CollectionView x:Name="JobsCollectionView" ItemsSource="{Binding Jobs}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                                TranslationX="6" Margin="0,0,6,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:JobListItemResponse">
                            <Border Margin="10,0" Padding="0"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                                    controls:RippleEffect.Enable="True">
                                <Border.GestureRecognizers>
                                    <!-- Navigation rides on the tap, not SelectionChanged, so tapping
                                         the already-selected item still opens it. -->
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference JobsCollectionView}, Path=BindingContext.SelectJobCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <!-- Ring driven by data, not the VSM Selected state — WinUI
                                     recycles containers without resetting visual state, which
                                     left stale rings on scrolled rows. -->
                                <controls:SelectionRing.IsSelected>
                                    <MultiBinding Converter="{StaticResource IsSelectedItemConverter}">
                                        <Binding Path="." />
                                        <Binding Path="SelectedItem" Source="{RelativeSource AncestorType={x:Type CollectionView}}" />
                                    </MultiBinding>
                                </controls:SelectionRing.IsSelected>
                                <Grid ColumnDefinitions="4,*" ColumnSpacing="0">
                                    <!-- Status-colored accent bar -->
                                    <BoxView Grid.Column="0" WidthRequest="4"
                                             BackgroundColor="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                             Margin="0,6" />

                                    <!-- Content -->
                                    <Grid Grid.Column="1" Padding="14,12" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding Status, Converter={StaticResource LabelCaseConverter}}" FontSize="11"
                                                   TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" />
                                            <Label Text="{Binding CustomerName}" FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="3" HorizontalOptions="End">
                                            <Label Text="Priority" FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                                   HorizontalTextAlignment="End" />
                                            <Label Text="{Binding Priority, Converter={StaticResource LabelCaseConverter}}" FontSize="13" FontAttributes="Bold"
                                                   TextColor="{Binding Priority, Converter={StaticResource PriorityColorConverter}}"
                                                   HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </controls:DataStateView.Body>
        </controls:DataStateView>

        <!-- FAB (overlaid on list) -->
        <controls:FloatingActionButton Grid.Row="2"
                                       Command="{Binding AddJobCommand}" ZIndex="10" />
    </Grid>
</ContentView>