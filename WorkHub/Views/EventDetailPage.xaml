<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkHub.ViewModels"
             xmlns:models="clr-namespace:WorkHub.Models"
             xmlns:controls="clr-namespace:WorkHub.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="WorkHub.Views.EventDetailPage"
             x:DataType="vm:EventDetailViewModel"
             Shell.NavBarIsVisible="False"
             Title="{Binding PageTitle}">

    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Spacing="16" Padding="16" HorizontalOptions="Fill">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                <controls:BackButton Command="{Binding GoBackCommand}" />
                <Label Grid.Column="1" Text="{Binding PageTitle}" FontSize="20" FontAttributes="Bold" VerticalTextAlignment="Center" />
                <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0" Padding="4" VerticalOptions="Center"
                        IsVisible="{Binding IsNew, Converter={StaticResource InverseBoolConverter}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <shapes:Path Data="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"
                                     Fill="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                     Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        <Label Text="Delete" FontSize="14" FontFamily="OpenSansSemibold" VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Entry Placeholder="Event Title *" Text="{Binding Title}" />

            <Editor Placeholder="Description" Text="{Binding Description}" HeightRequest="80" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Date" Style="{StaticResource FieldLabel}" />
                <DatePicker Date="{Binding StartDate}" HorizontalOptions="Start" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsAllDay, Converter={StaticResource InverseBoolConverter}}">
                <Label Text="Start Time" Style="{StaticResource FieldLabel}" />
                <TimePicker Time="{Binding StartTime}" HorizontalOptions="Start" />
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <Label Text="All Day" VerticalTextAlignment="Center" />
                <Switch IsToggled="{Binding IsAllDay}" />
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsAllDay, Converter={StaticResource InverseBoolConverter}}">
                <Label Text="End Date" Style="{StaticResource FieldLabel}" />
                <DatePicker Date="{Binding EndDate}" HorizontalOptions="Start" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsAllDay, Converter={StaticResource InverseBoolConverter}}">
                <Label Text="End Time" Style="{StaticResource FieldLabel}" />
                <TimePicker Time="{Binding EndTime}" HorizontalOptions="Start" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Customer (optional)" Style="{StaticResource FieldLabel}" />

                <!-- Selected customer display / tap to open picker -->
                <Frame Padding="12" CornerRadius="12" BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceCardDark}}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleCustomerPickerCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Label Text="{Binding SelectedCustomer.DisplayName, FallbackValue='Tap to select a customer...'}"
                               VerticalTextAlignment="Center" FontSize="15" />
                        <Label Grid.Column="1" Text="✕" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                               VerticalTextAlignment="Center" Padding="8,0"
                               IsVisible="{Binding SelectedCustomer, Converter={StaticResource IsNotNullConverter}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearCustomerCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label Grid.Column="2" Text="▾" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Frame>

                <!-- Searchable customer list -->
                <Frame Padding="0" CornerRadius="12" BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceCardDark}}"
                       IsVisible="{Binding IsCustomerPickerOpen}" HeightRequest="250">
                    <VerticalStackLayout>
                        <SearchBar x:Name="CustomerSearchBar" Placeholder="Search customers..." Text="{Binding CustomerSearchText}" Margin="0" />
                        <CollectionView ItemsSource="{Binding FilteredCustomers}" HeightRequest="200"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="No customers found" Padding="16" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       HorizontalTextAlignment="Center" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CustomerResponse">
                                    <Grid Padding="12,8">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EventDetailViewModel}}, Path=PickCustomerCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout>
                                            <Label Text="{Binding DisplayName}" FontSize="15" />
                                            <Label Text="{Binding PrimaryPhone}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                   IsVisible="{Binding PrimaryPhone, Converter={StaticResource StringNotEmptyConverter}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <!-- Assigned Users (tag editor) -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Assigned To" FontSize="14" FontAttributes="Bold" />
                <Border Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="6" MinimumHeightRequest="44">
                    <FlexLayout x:Name="ChipContainer" Wrap="Wrap" AlignItems="Center"
                                Direction="Row" JustifyContent="Start" />
                </Border>

                <!-- Suggestions dropdown -->
                <CollectionView ItemsSource="{Binding FilteredUsers}" IsVisible="{Binding ShowUserSuggestions}"
                                MaximumHeightRequest="150">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:UserBriefResponse">
                            <Border Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" StrokeThickness="0.5"
                                    Padding="10,8" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EventDetailViewModel}}, Path=SelectSuggestionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Name}" FontSize="14" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}" />

            <Button Text="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
