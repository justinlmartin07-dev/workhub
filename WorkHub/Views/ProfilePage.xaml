<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkHub.ViewModels"
             xmlns:controls="clr-namespace:WorkHub.Controls"
             x:Class="WorkHub.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="">

    <controls:DataStateView IsLoading="{Binding IsLoading}" HasError="{Binding HasError}"
                            HasContent="{Binding HasContent}" ErrorMessage="{Binding ErrorMessage}"
                            RetryCommand="{Binding LoadProfileCommand}">
        <controls:DataStateView.Body>
            <ScrollView>
                <VerticalStackLayout Spacing="16" Padding="24,12,24,16"
                                     HorizontalOptions="Fill" MaximumWidthRequest="960">

                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                        <controls:BackButton Command="{Binding GoBackCommand}" />
                        <Label Grid.Column="1" Text="Profile"
                               FontSize="20" FontAttributes="Bold"
                               VerticalTextAlignment="Center" />
                    </Grid>

                    <!-- Avatar row (avatar left, name/email/photo-buttons right) -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border WidthRequest="80" HeightRequest="80"
                                StrokeShape="RoundRectangle 40"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryMuted}}"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                            <Grid>
                                <Label Text="{Binding UserInitial}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                       FontSize="32" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryMuted}, Dark={StaticResource PrimaryLight}}" />
                                <Image Source="{Binding Profile.ProfilePhotoUrl}" Aspect="AspectFill"
                                       IsVisible="{Binding Profile.ProfilePhotoUrl, Converter={StaticResource StringNotEmptyConverter}}" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding Profile.Name}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding Profile.Email}" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <HorizontalStackLayout Spacing="12">
                                <Button Text="Change Photo" BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        Command="{Binding ChangePhotoCommand}" Padding="4,2" FontSize="12" />
                                <Button Text="Remove" BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                        Command="{Binding DeletePhotoCommand}" Padding="4,2" FontSize="12"
                                        IsVisible="{Binding Profile.ProfilePhotoUrl, Converter={StaticResource StringNotEmptyConverter}}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Personal Information Card -->
                    <Border StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                            StrokeShape="RoundRectangle 14" Padding="16,12">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="Personal Information" FontSize="14" FontAttributes="Bold"
                                       VerticalTextAlignment="Center" />
                                <Button Grid.Column="1" Text="Edit"
                                        IsVisible="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        Command="{Binding ToggleEditCommand}"
                                        Padding="8,4" FontSize="13" />
                                <Button Grid.Column="1" Text="Cancel"
                                        IsVisible="{Binding IsEditing}"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                        Command="{Binding ToggleEditCommand}"
                                        Padding="8,4" FontSize="13" />
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />

                            <Grid x:Name="FieldsGrid" ColumnSpacing="16" RowSpacing="12">
                                <VerticalStackLayout x:Name="NameField" Spacing="4">
                                    <Label Text="NAME" FontSize="10" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                    <Entry Text="{Binding Name}"
                                           IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout x:Name="EmailField" Spacing="4" VerticalOptions="Center">
                                    <Label Text="EMAIL" FontSize="10" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                    <Label Text="{Binding Profile.Email}" FontSize="14" />
                                </VerticalStackLayout>

                                <VerticalStackLayout x:Name="MemberSinceField" Spacing="4">
                                    <Label Text="MEMBER SINCE" FontSize="10" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                    <Label Text="{Binding Profile.CreatedAt, Converter={StaticResource DateFormatConverter}}"
                                           FontSize="14" />
                                </VerticalStackLayout>
                            </Grid>

                            <Button Text="Save Changes" Command="{Binding SaveProfileCommand}"
                                    IsVisible="{Binding IsEditing}"
                                    HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Account Actions Card -->
                    <Border StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                            StrokeShape="RoundRectangle 14" Padding="16,12">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Account" FontSize="14" FontAttributes="Bold" />
                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />

                            <Grid x:Name="ActionsGrid" ColumnSpacing="12" RowSpacing="10">
                                <Button x:Name="ChangePasswordButton" Text="Change Password"
                                        Command="{Binding ChangePasswordCommand}"
                                        HorizontalOptions="Fill" />
                                <Button x:Name="LogoutButton" Text="Logout"
                                        Command="{Binding LogoutCommand}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                        TextColor="White"
                                        HorizontalOptions="Fill" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                           IsVisible="{Binding HasError}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </ScrollView>
        </controls:DataStateView.Body>
    </controls:DataStateView>
</ContentPage>
