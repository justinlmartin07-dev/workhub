<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkHub.ViewModels"
             xmlns:models="clr-namespace:WorkHub.Models"
             xmlns:controls="clr-namespace:WorkHub.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="WorkHub.Views.CustomerDetailPage"
             x:DataType="vm:CustomerDetailViewModel"
             x:Name="thisPage"
             Shell.NavBarIsVisible="False"
             Title="{Binding Customer.Name, FallbackValue='Customer'}">

    <controls:DataStateView IsLoading="{Binding IsLoading}" HasError="{Binding HasError}"
                            HasContent="{Binding HasContent}" ErrorMessage="{Binding ErrorMessage}"
                            RetryCommand="{Binding LoadCustomerCommand}">
        <controls:DataStateView.Body>
            <ScrollView>
                <VerticalStackLayout Spacing="16" Padding="16">
                    <!-- Header with Edit/Delete -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <controls:BackButton Command="{Binding GoBackCommand}"
                                             IsVisible="{Binding IsNarrowLayout, Source={x:Reference thisPage}}" />
                        <Label Grid.Column="1" Text="{Binding Customer.Name, FallbackValue='Customer'}" FontSize="20" FontAttributes="Bold"
                               VerticalTextAlignment="Center" />
                        <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0" Padding="4" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding EditCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <shapes:Path Data="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"
                                             Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                             Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                <Label Text="Edit" FontSize="14" FontFamily="OpenSansSemibold" VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="3" BackgroundColor="Transparent" StrokeThickness="0" Padding="4" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <shapes:Path Data="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"
                                             Fill="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                             Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                <Label Text="Delete" FontSize="14" FontFamily="OpenSansSemibold" VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Contact Info -->
                    <Frame Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Contact Information" Style="{StaticResource SectionHeading}" />

                            <!-- Phone Numbers -->
                            <CollectionView ItemsSource="{Binding PhoneContacts}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CustomerContactResponse">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,2">
                                            <Label Text="{Binding Label, StringFormat='{0}:'}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" WidthRequest="60" />
                                            <Label Grid.Column="1" Text="{Binding Value}" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerDetailViewModel}}, Path=CallPhoneCommand}"
                                                                          CommandParameter="{Binding Value}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Email Addresses -->
                            <CollectionView ItemsSource="{Binding EmailContacts}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CustomerContactResponse">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,2">
                                            <Label Text="{Binding Label, StringFormat='{0}:'}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" WidthRequest="60" />
                                            <Label Grid.Column="1" Text="{Binding Value}" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerDetailViewModel}}, Path=SendEmailCommand}"
                                                                          CommandParameter="{Binding Value}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <!-- Address -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,2">
                                <Label Text="Address:" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                <Label Grid.Column="1" Text="{Binding Customer.Address, FallbackValue='-'}" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenAddressInMapsCommand}" />
                                    </Label.GestureRecognizers>
                                    <FlyoutBase.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Open in Maps" Command="{Binding OpenAddressInMapsCommand}" />
                                            <MenuFlyoutItem Text="Open in Google Earth" Command="{Binding OpenAddressInEarthCommand}" />
                                        </MenuFlyout>
                                    </FlyoutBase.ContextFlyout>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Notes -->
                    <Frame Style="{StaticResource Card}"
                           IsVisible="{Binding Customer.Notes, Converter={StaticResource StringNotEmptyConverter}}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Notes" Style="{StaticResource SectionHeading}" />
                            <Label Text="{Binding Customer.Notes}" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Photos -->
                    <Frame Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Label Text="Photos" Style="{StaticResource SectionHeading}" VerticalTextAlignment="Center" />
                                <Button Grid.Column="1" Text="Pick" Style="{StaticResource SecondaryButton}" Command="{Binding PickPhotoCommand}" />
                                <Button Grid.Column="2" Text="Camera" Style="{StaticResource SecondaryButton}" Command="{Binding TakePhotoCommand}" />
                            </Grid>
                            <CollectionView ItemsSource="{Binding Customer.Photos}" HeightRequest="120"
                                            ItemsLayout="HorizontalList">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PhotoResponse">
                                        <Border StrokeShape="RoundRectangle 8" Margin="0,0,8,0" StrokeThickness="0">
                                            <Image Source="{Binding Url}" WidthRequest="120" HeightRequest="120" Aspect="AspectFill">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerDetailViewModel}}, Path=ViewPhotosCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <!-- Location Photos Link -->
                            <Label IsVisible="{Binding LocationPhotoCount, Converter={StaticResource StringNotEmptyConverter}}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="View " />
                                        <Span Text="{Binding LocationPhotoCount}" FontAttributes="Bold" />
                                        <Span Text=" photos at this location" />
                                    </FormattedString>
                                </Label.FormattedText>
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewLocationPhotosCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Jobs -->
                    <Frame Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Jobs" Style="{StaticResource SectionHeading}" VerticalTextAlignment="Center" />
                                <Button Grid.Column="1" Text="+ Add Job" Style="{StaticResource SecondaryButton}" Command="{Binding AddJobCommand}" />
                            </Grid>
                            <CollectionView ItemsSource="{Binding Customer.Jobs}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:JobBriefResponse">
                                        <Grid Padding="8,6" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Border StrokeShape="RoundRectangle 4" WidthRequest="8" HeightRequest="8"
                                                    BackgroundColor="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                                    VerticalOptions="Center" StrokeThickness="0" />
                                            <Label Grid.Column="1" Text="{Binding Title}" VerticalTextAlignment="Center" />
                                            <Label Grid.Column="2" Text="{Binding Status, Converter={StaticResource LabelCaseConverter}}" FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" VerticalTextAlignment="Center" />
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerDetailViewModel}}, Path=ViewJobCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </ScrollView>
        </controls:DataStateView.Body>
    </controls:DataStateView>
</ContentPage>
