<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkHub.ViewModels"
             xmlns:models="clr-namespace:WorkHub.Models"
             x:Class="WorkHub.Views.JobEditPage"
             x:DataType="vm:JobEditViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="24" HorizontalOptions="Fill">
            <!-- Customer picker (new only) -->
            <VerticalStackLayout IsVisible="{Binding IsNew}" Spacing="4">
                <Label Text="Customer *" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />

                <!-- Selected customer display / tap to open picker -->
                <Frame Padding="12" CornerRadius="12" BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceCardDark}}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleCustomerPickerCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding SelectedCustomer.Name, FallbackValue='Tap to select a customer...'}"
                               TextColor="{Binding SelectedCustomer, Converter={StaticResource StringNotEmptyConverter}, FallbackValue={StaticResource Gray400}}"
                               VerticalTextAlignment="Center" FontSize="15" />
                        <Label Grid.Column="1" Text="v" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Frame>

                <!-- Searchable customer list (shown when open) -->
                <Frame Padding="0" CornerRadius="12" BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                       IsVisible="{Binding IsCustomerPickerOpen}" HeightRequest="250">
                    <VerticalStackLayout>
                        <SearchBar x:Name="CustomerSearchBar" Placeholder="Search customers..." Text="{Binding CustomerSearchText}"
                                   Margin="0" />
                        <CollectionView ItemsSource="{Binding FilteredCustomers}" HeightRequest="200"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <Label Text="No customers found" Padding="16" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       HorizontalTextAlignment="Center" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CustomerResponse">
                                    <Grid Padding="12,8" ColumnDefinitions="*">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Gray100}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobEditViewModel}}, Path=PickCustomerCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Name}" FontSize="15" />
                                            <Label Text="{Binding Phone}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                   IsVisible="{Binding Phone, Converter={StaticResource StringNotEmptyConverter}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

            <Entry Placeholder="Job Title *" Text="{Binding Title}" ReturnType="Next" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Status" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                <Picker ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Priority" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Text="Low" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" VerticalTextAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding PrioritySliderValue}" />
                    <Label Grid.Column="2" Text="High" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" VerticalTextAlignment="Center" />
                </Grid>
            </VerticalStackLayout>

            <!-- Address -->
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Address" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" VerticalTextAlignment="Center" />
                    <Button Grid.Column="1" Text="Use Customer Address" BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" Command="{Binding UseCustomerAddressCommand}"
                            Padding="4" FontSize="12" />
                </Grid>
                <Entry Placeholder="Street" Text="{Binding Street}" ReturnType="Next" />
                <!-- Address suggestions dropdown -->
                <CollectionView ItemsSource="{Binding AddressSuggestions}" IsVisible="{Binding ShowAddressSuggestions}"
                                SelectionMode="None" HeightRequest="150">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AddressSuggestionResponse">
                            <Grid Padding="8,6" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceCardDark}}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobEditViewModel}}, Path=SelectAddressSuggestionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout>
                                    <Label Text="{Binding MainText}" FontSize="14" />
                                    <Label Text="{Binding SecondaryText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="8">
                    <Entry Placeholder="City" Text="{Binding City}" ReturnType="Next" />
                    <Entry Grid.Column="1" Placeholder="State" Text="{Binding State}" ReturnType="Next" />
                    <Entry Grid.Column="2" Placeholder="Zip" Text="{Binding Zip}" ReturnType="Next" />
                </Grid>
            </VerticalStackLayout>

            <Editor Placeholder="Scope Notes" Text="{Binding ScopeNotes}" HeightRequest="120" />

            <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" IsVisible="{Binding HasError}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Cancel" BackgroundColor="{StaticResource Gray200}"
                        TextColor="{StaticResource Gray900}" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
