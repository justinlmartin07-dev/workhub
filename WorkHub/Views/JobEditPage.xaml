<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkHub.ViewModels"
             xmlns:models="clr-namespace:WorkHub.Models"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="WorkHub.Views.JobEditPage"
             x:DataType="vm:JobEditViewModel"
             Title="{Binding PageTitle}">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="24" HorizontalOptions="Fill">
            <!-- Customer picker (new only) -->
            <VerticalStackLayout IsVisible="{Binding IsNew}" Spacing="4">
                <Label Text="Customer *" Style="{StaticResource FieldLabel}" />

                <!-- Selected customer display / tap to open picker -->
                <Frame Padding="12" CornerRadius="12" BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                       BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceCardDark}}">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleCustomerPickerCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding SelectedCustomer.DisplayName, FallbackValue='Tap to select a customer...'}"
                               TextColor="{Binding SelectedCustomer, Converter={StaticResource StringNotEmptyConverter}, FallbackValue={StaticResource Gray400}}"
                               VerticalTextAlignment="Center" FontSize="15" />
                        <!-- Material Symbols "expand_more" -->
                        <shapes:Path Grid.Column="1" Data="M480-345 240-585l56-56 184 184 184-184 56 56-240 240Z"
                                     Fill="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                     Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    </Grid>
                </Frame>

            </VerticalStackLayout>

            <Entry Placeholder="Job Title *" Text="{Binding Title}" ReturnType="Next" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Priority" Style="{StaticResource FieldLabel}" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Text="Low" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" VerticalTextAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding PrioritySliderValue}" />
                    <Label Grid.Column="2" Text="High" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" VerticalTextAlignment="Center" />
                </Grid>
            </VerticalStackLayout>

            <!-- Address -->
            <VerticalStackLayout Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Address" Style="{StaticResource FieldLabel}" VerticalTextAlignment="Center" />
                    <Button Grid.Column="1" Text="Use Customer Address" Style="{StaticResource SecondaryButton}"
                            Command="{Binding UseCustomerAddressCommand}" FontSize="12" />
                </Grid>
                <Entry Placeholder="Street" Text="{Binding Street}" ReturnType="Next" />
                <!-- Address suggestions dropdown -->
                <CollectionView ItemsSource="{Binding AddressSuggestions}" IsVisible="{Binding ShowAddressSuggestions}"
                                SelectionMode="None" HeightRequest="150">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AddressSuggestionResponse">
                            <Grid Padding="8,6" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceCardDark}}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobEditViewModel}}, Path=SelectAddressSuggestionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout>
                                    <Label Text="{Binding MainText}" FontSize="14" />
                                    <Label Text="{Binding SecondaryText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="8">
                    <Entry Placeholder="City" Text="{Binding City}" ReturnType="Next" />
                    <Entry Grid.Column="1" Placeholder="State" Text="{Binding State}" ReturnType="Next" />
                    <Entry Grid.Column="2" Placeholder="Zip" Text="{Binding Zip}" ReturnType="Next" />
                </Grid>
            </VerticalStackLayout>

            <Editor Placeholder="Scope Notes" Text="{Binding ScopeNotes}"
                    AutoSize="TextChanges" MinimumHeightRequest="120" />

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Cancel" Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
        </VerticalStackLayout>
    </ScrollView>

    <!-- Customer picker overlay: floats above the page instead of expanding inside
         the ScrollView — inline expansion resized the scroll content, which made
         WinUI jump focus/scroll back to the top of the page on first open. -->
    <BoxView IsVisible="{Binding IsCustomerPickerOpen}" Color="#80000000">
        <BoxView.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding ToggleCustomerPickerCommand}" />
        </BoxView.GestureRecognizers>
    </BoxView>
    <Frame IsVisible="{Binding IsCustomerPickerOpen}" Padding="0" CornerRadius="12"
           BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
           BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceCardDark}}"
           Margin="24" MaximumWidthRequest="420" HeightRequest="420"
           HorizontalOptions="Center" VerticalOptions="Center">
        <Grid RowDefinitions="Auto,*">
            <SearchBar x:Name="CustomerSearchBar" Placeholder="Search customers..." Text="{Binding CustomerSearchText}" Margin="0" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding FilteredCustomers}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No customers found" Padding="16" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CustomerResponse">
                        <Grid Padding="12,8" ColumnDefinitions="*">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobEditViewModel}}, Path=PickCustomerCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout>
                                <Label Text="{Binding DisplayName}" FontSize="15" />
                                <Label Text="{Binding PrimaryPhone}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                       IsVisible="{Binding PrimaryPhone, Converter={StaticResource StringNotEmptyConverter}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Frame>
    </Grid>
</ContentPage>
