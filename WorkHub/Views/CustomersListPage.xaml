<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkHub.ViewModels"
             xmlns:models="clr-namespace:WorkHub.Models"
             xmlns:controls="clr-namespace:WorkHub.Controls"
             x:Class="WorkHub.Views.CustomersListPage"
             x:DataType="vm:CustomersListViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header -->
        <Label Grid.Row="0" Text="Customers" FontSize="20" FontAttributes="Bold" Margin="16,12,16,8" />

        <!-- Search -->
        <SearchBar Grid.Row="1" Placeholder="Search customers..." Text="{Binding SearchText}"
                   SearchCommand="{Binding SearchCommand}" Margin="8" />

        <!-- Data State View -->
        <controls:DataStateView Grid.Row="2"
            IsLoading="{Binding IsLoading}" HasError="{Binding HasError}" IsEmpty="{Binding IsEmpty}"
            HasContent="{Binding HasContent}" ErrorMessage="{Binding ErrorMessage}"
            EmptyMessage="No customers yet" RetryCommand="{Binding LoadCustomersCommand}">
            <controls:DataStateView.Body>
                <CollectionView x:Name="CustomersCollectionView" ItemsSource="{Binding Customers}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                TranslationX="6" Margin="0,0,6,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CustomerResponse">
                            <Border Margin="10,0" Padding="0"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    Stroke="Transparent"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                                    controls:RippleEffect.Enable="True">
                                <Border.GestureRecognizers>
                                    <!-- Navigation rides on the tap, not SelectionChanged, so tapping
                                         the already-selected item still opens it. -->
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference CustomersCollectionView}, Path=BindingContext.SelectCustomerCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                                <Setter Property="Shadow">
                                                    <Shadow Brush="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                            Offset="0,2" Radius="12" Opacity="0.25" />
                                                </Setter>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid ColumnDefinitions="4,*" ColumnSpacing="0">
                                    <!-- Left accent bar -->
                                    <BoxView Grid.Column="0" WidthRequest="4"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                             Margin="0,6" />

                                    <!-- Content -->
                                    <VerticalStackLayout Grid.Column="1" Padding="14,12" Spacing="3">
                                        <!-- Company is the primary identity when present; falls back to the name -->
                                        <Label Text="{Binding DisplayName}" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="{Binding Name}" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                               IsVisible="{Binding CompanyName, Converter={StaticResource StringNotEmptyConverter}}"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Text="{Binding Address}" FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                               IsVisible="{Binding Address, Converter={StaticResource StringNotEmptyConverter}}"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </controls:DataStateView.Body>
        </controls:DataStateView>

        <!-- FAB (overlaid on list) -->
        <controls:FloatingActionButton Grid.Row="1"
                                       Command="{Binding AddCustomerCommand}" ZIndex="10" />
    </Grid>
</ContentView>