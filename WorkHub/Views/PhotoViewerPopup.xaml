<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:WorkHub.ViewModels"
               xmlns:models="clr-namespace:WorkHub.Models"
               xmlns:controls="clr-namespace:WorkHub.Controls"
               xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
               x:Class="WorkHub.Views.PhotoViewerPopup"
               x:Name="thisPopup"
               x:DataType="vm:PhotoViewerViewModel"
               CanBeDismissedByTappingOutsideOfPopup="True"
               Color="Transparent"
               HorizontalOptions="Fill"
               VerticalOptions="Fill">

    <!-- Top spacer keeps the popup below the Windows title bar (toolkit Popup is a
         WinUI overlay that ignores the global ExtendsContentIntoTitleBar=false).
         Height for TopSpacerRow is set in code-behind per platform. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopSpacerRow" Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="1" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}">
        <Grid>
            <!-- Main content: top rule, header, bottom rule, photo -->
            <Grid RowDefinitions="1,Auto,1,*">

                <BoxView Grid.Row="0" HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />

                <!-- Header: title + ellipsis + close (all same font size) -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Padding="16,10" ColumnSpacing="4">
                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold"
                           VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
                    <Button Grid.Column="1" Text="⋯" FontSize="18" Padding="0"
                            WidthRequest="40" HeightRequest="40"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                            Command="{Binding ToggleMenuCommand}" />
                    <Button Grid.Column="2" Text="✕" FontSize="18" Padding="0"
                            WidthRequest="40" HeightRequest="40"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"
                            Command="{Binding CloseCommand}" />
                </Grid>

                <BoxView Grid.Row="2" HeightRequest="1"
                         Color="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />

                <!-- Photo area: 1/4" margin in wide mode, fill in narrow -->
                <Grid Grid.Row="3" Padding="{Binding PhotoAreaPadding, Source={x:Reference thisPopup}}">
                    <controls:DataStateView IsLoading="{Binding IsLoading}" HasError="{Binding HasError}"
                                            HasContent="{Binding HasContent}" ErrorMessage="{Binding ErrorMessage}">
                        <controls:DataStateView.Body>
                            <Grid BackgroundColor="White">
                                <!-- Windows: a plain Image driven by the chevron buttons.
                                     CarouselView is unusable there — swiping is janky and
                                     programmatic Position changes don't scroll backwards. -->
                                <Image Source="{Binding CurrentPhotoModel.Source}" Aspect="AspectFit"
                                       VerticalOptions="Fill" HorizontalOptions="Fill"
                                       IsVisible="{OnPlatform false, WinUI=true}" />
                                <!-- Android: swipeable carousel as before. -->
                                <CarouselView ItemsSource="{Binding Photos}" Position="{Binding CurrentIndex}" Loop="False"
                                              IsVisible="{OnPlatform true, WinUI=false}">
                                    <CarouselView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PhotoDisplayModel">
                                            <Image Source="{Binding Source}" Aspect="AspectFit"
                                                   VerticalOptions="Fill" HorizontalOptions="Fill" />
                                        </DataTemplate>
                                    </CarouselView.ItemTemplate>
                                </CarouselView>
                                <IndicatorView Position="{Binding CurrentIndex}" Count="{Binding Photos.Count}"
                                               HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,16"
                                               IndicatorColor="#80FFFFFF" SelectedIndicatorColor="White" />

                                <!-- Previous / next (Windows only) -->
                                <Button Text="&#x2039;" FontSize="26" Padding="0,0,0,4"
                                        WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                        BackgroundColor="#66000000" TextColor="White"
                                        HorizontalOptions="Start" VerticalOptions="Center" Margin="16,0,0,0"
                                        IsVisible="{OnPlatform false, WinUI=true}"
                                        Command="{Binding PreviousPhotoCommand}">
                                    <Button.Triggers>
                                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.3" />
                                        </Trigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="&#x203A;" FontSize="26" Padding="0,0,0,4"
                                        WidthRequest="44" HeightRequest="44" CornerRadius="22"
                                        BackgroundColor="#66000000" TextColor="White"
                                        HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,16,0"
                                        IsVisible="{OnPlatform false, WinUI=true}"
                                        Command="{Binding NextPhotoCommand}">
                                    <Button.Triggers>
                                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.3" />
                                        </Trigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </controls:DataStateView.Body>
                    </controls:DataStateView>
                </Grid>
            </Grid>

            <!-- Dismiss catcher: visible only while the menu is open -->
            <Grid IsVisible="{Binding IsMenuOpen}" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseMenuCommand}" />
                </Grid.GestureRecognizers>
            </Grid>

            <!-- Floating menu, anchored under the ellipsis button -->
            <Border IsVisible="{Binding IsMenuOpen}"
                    HorizontalOptions="End" VerticalOptions="Start"
                    Margin="0,56,60,0"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                    Padding="4"
                    MinimumWidthRequest="160">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="14,10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SaveCurrentPhotoCommand}" />
                        </Grid.GestureRecognizers>
                        <!-- Material Symbols "download" -->
                        <shapes:Path Data="M480-320 280-520l56-58 104 104v-326h80v326l104-104 56 58-200 200ZM240-160q-33 0-56.5-23.5T160-240v-120h80v120h480v-120h80v120q0 33-23.5 56.5T720-160H240Z"
                                     Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                     Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Save" FontSize="14" VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="14,10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShareCurrentPhotoCommand}" />
                        </Grid.GestureRecognizers>
                        <!-- Material Symbols "share" -->
                        <shapes:Path Data="M720-80q-50 0-85-35t-35-85q0-7 1-14.5t3-13.5L322-392q-17 15-38 23.5t-44 8.5q-50 0-85-35t-35-85q0-50 35-85t85-35q23 0 44 8.5t38 23.5l282-164q-2-6-3-13.5t-1-14.5q0-50 35-85t85-35q50 0 85 35t35 85q0 50-35 85t-85 35q-23 0-44-8.5T638-672L356-508q2 6 3 13.5t1 14.5q0 7-1 14.5t-3 13.5l282 164q17-15 38-23.5t44-8.5q50 0 85 35t35 85q0 50-35 85t-85 35Zm0-640q17 0 28.5-11.5T760-760q0-17-11.5-28.5T720-800q-17 0-28.5 11.5T680-760q0 17 11.5 28.5T720-720ZM240-440q17 0 28.5-11.5T280-480q0-17-11.5-28.5T240-520q-17 0-28.5 11.5T200-480q0 17 11.5 28.5T240-440Zm480 280q17 0 28.5-11.5T760-200q0-17-11.5-28.5T720-240q-17 0-28.5 11.5T680-200q0 17 11.5 28.5T720-160Z"
                                     Fill="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                                     Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Share" FontSize="14" VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="14,10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteCurrentPhotoCommand}" />
                        </Grid.GestureRecognizers>
                        <!-- Material Symbols "delete" — same path as the detail page Delete buttons -->
                        <shapes:Path Data="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"
                                     Fill="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                     Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Delete" FontSize="14" VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
        </Border>
    </Grid>
</toolkit:Popup>
