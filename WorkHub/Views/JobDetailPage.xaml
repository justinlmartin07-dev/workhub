<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkHub.ViewModels"
             xmlns:models="clr-namespace:WorkHub.Models"
             xmlns:controls="clr-namespace:WorkHub.Controls"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="WorkHub.Views.JobDetailPage"
             x:DataType="vm:JobDetailViewModel"
             x:Name="thisPage"
             Shell.NavBarIsVisible="False"
             Title="{Binding Job.Title, FallbackValue='Job'}">

    <ContentPage.Resources>
        <!-- Parts picker rows. Flat list of category headers + checkbox items:
             grouped CollectionView crashes on Windows when groups change at runtime. -->
        <DataTemplate x:Key="PickerHeaderTemplate" x:DataType="models:InventoryGroupHeader">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Padding="4,10,4,4">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TogglePickerGroupCommand, Source={RelativeSource AncestorType={x:Type vm:JobDetailViewModel}}}"
                                          CommandParameter="{Binding .}" />
                </Grid.GestureRecognizers>
                <!-- Chevron: points right when collapsed, down when expanded -->
                <shapes:Path Data="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"
                             Fill="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                             Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center">
                    <shapes:Path.Triggers>
                        <DataTrigger TargetType="shapes:Path" Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="Rotation" Value="90" />
                        </DataTrigger>
                    </shapes:Path.Triggers>
                </shapes:Path>
                <Label Grid.Column="1" Text="{Binding Category}" FontSize="13" FontAttributes="Bold"
                       VerticalTextAlignment="Center" />
                <Label Grid.Column="2" Text="{Binding ItemCount}" FontSize="11"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                       VerticalTextAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PickerItemTemplate" x:DataType="vm:SelectableInventoryItem">
            <Grid Padding="4,6" ColumnDefinitions="Auto,*">
                <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding Name}" FontSize="14" />
                    <Label Text="{Binding PartNumber}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                           IsVisible="{Binding PartNumber, Converter={StaticResource StringNotEmptyConverter}}" />
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>

        <controls:InventoryRowTemplateSelector x:Key="PickerRowTemplates"
                                               HeaderTemplate="{StaticResource PickerHeaderTemplate}"
                                               ItemTemplate="{StaticResource PickerItemTemplate}" />
    </ContentPage.Resources>

    <Grid>
        <!-- Main content -->
        <controls:DataStateView IsLoading="{Binding IsLoading}" HasError="{Binding HasError}"
                                HasContent="{Binding HasContent}" ErrorMessage="{Binding ErrorMessage}"
                                RetryCommand="{Binding LoadJobCommand}">
            <controls:DataStateView.Body>
                <ScrollView>
                    <VerticalStackLayout Spacing="16" Padding="16">
                        <!-- Header with Share/Edit/Delete -->
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                            <controls:BackButton Command="{Binding GoBackCommand}"
                                                 IsVisible="{Binding IsNarrowLayout, Source={x:Reference thisPage}}" />
                            <Label Grid.Column="1" Text="{Binding Job.Title, FallbackValue='Job'}" FontSize="20" FontAttributes="Bold"
                                   VerticalTextAlignment="Center" />
                            <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0" Padding="{OnPlatform 4, Android=8}" VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 8" controls:TapFeedback.Enable="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShareCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <shapes:Path Data="M680-80q-50 0-85-35t-35-85q0-6 3-28L282-392q-16 15-37 23.5t-45 8.5q-50 0-85-35t-35-85q0-50 35-85t85-35q24 0 45 8.5t37 23.5l281-164q-2-7-2.5-13.5T560-760q0-50 35-85t85-35q50 0 85 35t35 85q0 50-35 85t-85 35q-24 0-45-8.5T598-672L317-508q2 7 2.5 13.5t.5 14.5q0 8-.5 14.5T317-452l281 164q16-15 37-23.5t45-8.5q50 0 85 35t35 85q0 50-35 85t-85 35Z"
                                                 Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                 Aspect="Uniform" WidthRequest="{OnPlatform 16, Android=20}" HeightRequest="{OnPlatform 16, Android=20}" VerticalOptions="Center" />
                                    <Label Text="Share" FontSize="14" FontFamily="OpenSansSemibold" VerticalTextAlignment="Center"
                                           IsVisible="{OnPlatform true, Android=false}"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border Grid.Column="3" BackgroundColor="Transparent" StrokeThickness="0" Padding="{OnPlatform 4, Android=8}" VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 8" controls:TapFeedback.Enable="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EditCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <shapes:Path Data="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"
                                                 Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                 Aspect="Uniform" WidthRequest="{OnPlatform 16, Android=20}" HeightRequest="{OnPlatform 16, Android=20}" VerticalOptions="Center" />
                                    <Label Text="Edit" FontSize="14" FontFamily="OpenSansSemibold" VerticalTextAlignment="Center"
                                           IsVisible="{OnPlatform true, Android=false}"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border Grid.Column="4" BackgroundColor="Transparent" StrokeThickness="0" Padding="{OnPlatform 4, Android=8}" VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 8" controls:TapFeedback.Enable="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                    <shapes:Path Data="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"
                                                 Fill="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                                 Aspect="Uniform" WidthRequest="{OnPlatform 16, Android=20}" HeightRequest="{OnPlatform 16, Android=20}" VerticalOptions="Center" />
                                    <Label Text="Delete" FontSize="14" FontFamily="OpenSansSemibold" VerticalTextAlignment="Center"
                                           IsVisible="{OnPlatform true, Android=false}"
                                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Status/Priority -->
                        <Frame Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                <Label Text="Customer" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                <Label Grid.Column="1" Text="{Binding Job.CustomerName}" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ViewCustomerCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Label Grid.Row="1" Text="Status" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Job.Status}"
                                       TextColor="{Binding Job.Status, Converter={StaticResource StatusColorConverter}}" FontAttributes="Bold" />
                                <Label Grid.Row="2" Text="Priority" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Job.Priority}"
                                       TextColor="{Binding Job.Priority, Converter={StaticResource PriorityColorConverter}}" FontAttributes="Bold" />
                                <Label Grid.Row="3" Text="Contact" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       IsVisible="{Binding Job.MainContact, Converter={StaticResource IsNotNullConverter}}" />
                                <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="2"
                                                     IsVisible="{Binding Job.MainContact, Converter={StaticResource IsNotNullConverter}}">
                                    <Label Text="{Binding Job.MainContact.Display}" />
                                    <Label Text="{Binding Job.MainContact.Phone}" IsVisible="{Binding Job.MainContact.HasPhone, FallbackValue=false}"
                                           TextDecorations="Underline"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CallPhoneCommand}" CommandParameter="{Binding Job.MainContact.Phone}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label Text="{Binding Job.MainContact.Email}" IsVisible="{Binding Job.MainContact.HasEmail, FallbackValue=false}"
                                           TextDecorations="Underline"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding SendEmailCommand}" CommandParameter="{Binding Job.MainContact.Email}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>

                        <!-- Primary status action -->
                        <Button Text="Mark as Complete"
                                ImageSource="select_check_box_light.png"
                                ContentLayout="Left,8"
                                Command="{Binding MarkAsCompleteCommand}"
                                IsVisible="{Binding CanComplete}" />
                        <Button Text="Mark as Billed"
                                Command="{Binding MarkAsBilledCommand}"
                                IsVisible="{Binding CanBill}" />
                        <Button Text="Reopen Job"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ReopenJobCommand}"
                                IsVisible="{Binding CanReopen}" />

                        <!-- Secondary status actions -->
                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Button Text="Put on Hold"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding PutOnHoldCommand}"
                                    IsVisible="{Binding CanHold}" />
                            <Button Text="Cancel Job"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding CancelJobCommand}"
                                    IsVisible="{Binding CanCancel}" />
                        </HorizontalStackLayout>

                        <!-- Address -->
                        <Frame Style="{StaticResource Card}"
                               IsVisible="{Binding Job.Address, Converter={StaticResource StringNotEmptyConverter}}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Job Address" Style="{StaticResource SectionHeading}" />
                                <Label Text="{Binding Job.Address}" TextDecorations="Underline" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                    <Label.GestureRecognizers>
                                        <!-- Primary button only: a right-click must reach ONLY the
                                             ContextFlyout below, or the menu is instantly dismissed
                                             by Maps opening (TouchBehavior fired on any button). -->
                                        <TapGestureRecognizer Buttons="Primary" Command="{Binding OpenAddressInMapsCommand}" />
                                    </Label.GestureRecognizers>
                                    <Label.Behaviors>
                                        <!-- Android hold → Earth options. ContextFlyout covers Windows
                                             right-click; it does nothing on Android, hence the long-press. -->
                                        <toolkit:TouchBehavior LongPressCommand="{Binding ShowAddressOptionsCommand}" />
                                    </Label.Behaviors>
                                    <FlyoutBase.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Open in Maps" IconImageSource="map_pin.png"
                                                            Command="{Binding OpenAddressInMapsCommand}" />
                                            <MenuFlyoutItem Text="Open in Google Earth" IconImageSource="globe.png"
                                                            Command="{Binding OpenAddressInEarthCommand}" />
                                        </MenuFlyout>
                                    </FlyoutBase.ContextFlyout>
                                </Label>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Scope Notes -->
                        <Frame Style="{StaticResource Card}"
                               IsVisible="{Binding Job.ScopeNotes, Converter={StaticResource StringNotEmptyConverter}}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Scope Notes" Style="{StaticResource SectionHeading}" />
                                <Label Text="{Binding Job.ScopeNotes}" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Photos -->
                        <Frame Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <Label Text="Photos" Style="{StaticResource SectionHeading}" VerticalTextAlignment="Center" />
                                    <Button Grid.Column="1" Text="Pick" Style="{StaticResource SecondaryButton}" Command="{Binding PickPhotoCommand}" />
                                    <Button Grid.Column="2" Text="Camera" Style="{StaticResource SecondaryButton}" Command="{Binding TakePhotoCommand}" />
                                </Grid>
                                <Label Text="{Binding UploadStatus}"
                                       IsVisible="{Binding UploadStatus, Converter={StaticResource StringNotEmptyConverter}}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                <CollectionView ItemsSource="{Binding Photos}" HeightRequest="120"
                                                ItemsLayout="HorizontalList">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PhotoDisplayModel">
                                            <Border StrokeShape="RoundRectangle 8" Margin="0,0,8,0" StrokeThickness="0">
                                                <Image Source="{Binding Source}" WidthRequest="120" HeightRequest="120" Aspect="AspectFill">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobDetailViewModel}}, Path=ViewPhotosCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Items Used -->
                        <Frame Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Items Used" Style="{StaticResource SectionHeading}" VerticalTextAlignment="Center" />
                                    <Button Grid.Column="1" Text="+ Add" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding OpenPartsPanelCommand}" CommandParameter="used" />
                                </Grid>
                                <CollectionView ItemsSource="{Binding UsedItems}">
                                    <CollectionView.EmptyView>
                                        <Label Text="No items" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:JobItemResponse">
                                            <Grid Padding="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2" VerticalOptions="Center">
                                                <VerticalStackLayout VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" FontSize="14" LineBreakMode="TailTruncation" />
                                                    <!-- Part number + price share the second line: part numbers are
                                                         short, so the price gets the room the name row can't spare. -->
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <Label Text="{Binding PartNumber}" FontSize="12" LineBreakMode="TailTruncation"
                                                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                               IsVisible="{Binding PartNumber, Converter={StaticResource StringNotEmptyConverter}}" />
                                                        <Label Grid.Column="1" Text="{Binding PriceDisplay}" FontSize="12" VerticalTextAlignment="Center" Margin="0,0,3,0"
                                                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                               IsVisible="{Binding PriceDisplay, Converter={StaticResource StringNotEmptyConverter}}" />
                                                    </Grid>
                                                </VerticalStackLayout>
                                                <!-- Compact segmented stepper: [+][qty][−]. The Border clips the
                                                     square segments into the pill shape. -->
                                                <Border Grid.Column="1" StrokeThickness="1" Padding="0" VerticalOptions="Center"
                                                        Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                                                        StrokeShape="RoundRectangle 8">
                                                    <Grid ColumnDefinitions="22,34,22"
                                                          HeightRequest="{OnPlatform 30, Android=36}">
                                                        <Button Text="−" FontSize="15" Padding="0" Margin="0" CornerRadius="0"
                                                                HeightRequest="{OnPlatform 30, Android=36}"
                                                                VerticalOptions="Fill" MinimumWidthRequest="0" MinimumHeightRequest="0"
                                                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                                                Clicked="OnDecrementClicked" />
                                                        <!-- TwoWay: typing writes into the model, so Focused snapshots the
                                                             pre-edit value for the Unfocused handler's save-on-change check. -->
                                                        <Entry Grid.Column="1" Text="{Binding Quantity}" FontSize="13" Keyboard="Numeric" StyleId="stepper-qty"
                                                               Focused="OnQuantityEntryFocused"
                                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                               HeightRequest="{OnPlatform 30, Android=36}" Margin="0"
                                                               BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceInputLight}, Dark={StaticResource SurfaceInputDark}}"
                                                               Unfocused="OnQuantityEntryUnfocused" />
                                                        <Button Grid.Column="2" Text="+" FontSize="15" Padding="0" Margin="0" CornerRadius="0"
                                                                HeightRequest="{OnPlatform 30, Android=36}"
                                                                VerticalOptions="Fill" MinimumWidthRequest="0" MinimumHeightRequest="0"
                                                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                                                Clicked="OnIncrementClicked" />
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0"
                                                        Padding="4" VerticalOptions="Center"
                                                        StrokeShape="RoundRectangle 8" controls:TapFeedback.Enable="True">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobDetailViewModel}}, Path=DeleteItemCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <!-- Material Symbols "close" -->
                                                    <shapes:Path Data="M256-200l-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"
                                                                 Fill="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                                                 Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Items To Order -->
                        <Frame Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Items To Order" Style="{StaticResource SectionHeading}" VerticalTextAlignment="Center" />
                                    <Button Grid.Column="1" Text="+ Add" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding OpenPartsPanelCommand}" CommandParameter="to_order" />
                                </Grid>
                                <CollectionView ItemsSource="{Binding ToOrderItems}">
                                    <CollectionView.EmptyView>
                                        <Label Text="No items" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:JobItemResponse">
                                            <Grid Padding="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2" VerticalOptions="Center">
                                                <VerticalStackLayout VerticalOptions="Center">
                                                    <!-- Ordered items stay listed for reference but read as done. -->
                                                    <Label Text="{Binding Name}" FontSize="14" LineBreakMode="TailTruncation">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsOrdered}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <!-- Part number + price share the second line: part numbers are
                                                         short, so the price gets the room the name row can't spare. -->
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <Label Text="{Binding PartNumber}" FontSize="12" LineBreakMode="TailTruncation"
                                                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                               IsVisible="{Binding PartNumber, Converter={StaticResource StringNotEmptyConverter}}">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsOrdered}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <Label Grid.Column="1" Text="{Binding PriceDisplay}" FontSize="12" VerticalTextAlignment="Center" Margin="0,0,3,0"
                                                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                                               IsVisible="{Binding PriceDisplay, Converter={StaticResource StringNotEmptyConverter}}" />
                                                    </Grid>
                                                </VerticalStackLayout>
                                                <!-- Compact segmented stepper: [+][qty][−]. The Border clips the
                                                     square segments into the pill shape. Once the part is ordered
                                                     the quantity is locked — the order already went out with it. -->
                                                <Border Grid.Column="1" StrokeThickness="1" Padding="0" VerticalOptions="Center"
                                                        Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                                                        StrokeShape="RoundRectangle 8">
                                                    <Grid ColumnDefinitions="22,34,22"
                                                          HeightRequest="{OnPlatform 30, Android=36}">
                                                        <Grid.Triggers>
                                                            <DataTrigger TargetType="Grid" Binding="{Binding IsOrdered}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                                <Setter Property="Opacity" Value="0.4" />
                                                            </DataTrigger>
                                                        </Grid.Triggers>
                                                        <Button Text="−" FontSize="15" Padding="0" Margin="0" CornerRadius="0"
                                                                HeightRequest="{OnPlatform 30, Android=36}"
                                                                VerticalOptions="Fill" MinimumWidthRequest="0" MinimumHeightRequest="0"
                                                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                                                Clicked="OnDecrementClicked" />
                                                        <!-- TwoWay: typing writes into the model, so Focused snapshots the
                                                             pre-edit value for the Unfocused handler's save-on-change check. -->
                                                        <Entry Grid.Column="1" Text="{Binding Quantity}" FontSize="13" Keyboard="Numeric" StyleId="stepper-qty"
                                                               Focused="OnQuantityEntryFocused"
                                                               HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                                               HeightRequest="{OnPlatform 30, Android=36}" Margin="0"
                                                               BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceInputLight}, Dark={StaticResource SurfaceInputDark}}"
                                                               Unfocused="OnQuantityEntryUnfocused" />
                                                        <Button Grid.Column="2" Text="+" FontSize="15" Padding="0" Margin="0" CornerRadius="0"
                                                                HeightRequest="{OnPlatform 30, Android=36}"
                                                                VerticalOptions="Fill" MinimumWidthRequest="0" MinimumHeightRequest="0"
                                                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                                                                Clicked="OnIncrementClicked" />
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0"
                                                        Padding="4" VerticalOptions="Center"
                                                        StrokeShape="RoundRectangle 8" controls:TapFeedback.Enable="True">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobDetailViewModel}}, Path=DeleteItemCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <!-- Material Symbols "close" -->
                                                    <shapes:Path Data="M256-200l-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"
                                                                 Fill="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                                                 Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Notes -->
                        <Frame Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Notes" Style="{StaticResource SectionHeading}" />
                                <Label Text="Editing note — tap ✕ to cancel" FontSize="11" IsVisible="{Binding IsEditingNote}"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Editor x:Name="NoteEditor" Placeholder="Add a note..." Text="{Binding NewNoteText}"
                                            AutoSize="TextChanges" MinimumHeightRequest="44" />
                                    <Border Grid.Column="1" WidthRequest="44" HeightRequest="44"
                                            StrokeShape="RoundRectangle 22" StrokeThickness="0"
                                            IsVisible="{Binding IsEditingNote}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                                            controls:TapFeedback.Enable="True"
                                            controls:TapFeedback.HoverLight="{StaticResource Gray200}"
                                            controls:TapFeedback.HoverDark="{StaticResource Gray500}"
                                            VerticalOptions="End">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding CancelEditNoteCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="✕" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                    </Border>
                                    <Border Grid.Column="2" WidthRequest="44" HeightRequest="44"
                                            StrokeShape="RoundRectangle 22" StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                            controls:TapFeedback.Enable="True"
                                            controls:TapFeedback.HoverLight="{StaticResource PrimaryHover}"
                                            controls:TapFeedback.HoverDark="{StaticResource PrimaryDarkHover}"
                                            VerticalOptions="End">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding AddNoteCommand}" />
                                        </Border.GestureRecognizers>
                                        <shapes:Path Data="M120-160v-640l760 320-760 320Zm80-120 474-200-474-200v140l240 60-240 60v140Zm0 0v-400 400Z"
                                                     Fill="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                                                     Aspect="Uniform" WidthRequest="20" HeightRequest="20"
                                                     HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                                <CollectionView ItemsSource="{Binding Job.Notes}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:JobNoteResponse">
                                            <SwipeView>
                                                <SwipeView.RightItems>
                                                    <SwipeItems Mode="Reveal">
                                                        <SwipeItem Text="Edit" BackgroundColor="{StaticResource Primary}"
                                                                   IconImageSource="note_edit_light.png"
                                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobDetailViewModel}}, Path=EditNoteCommand}"
                                                                   CommandParameter="{Binding .}" />
                                                        <SwipeItem Text="Delete" BackgroundColor="{StaticResource Danger}"
                                                                   IconImageSource="note_delete_light.png"
                                                                   Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobDetailViewModel}}, Path=DeleteNoteCommand}"
                                                                   CommandParameter="{Binding .}" />
                                                    </SwipeItems>
                                                </SwipeView.RightItems>
                                                <VerticalStackLayout Padding="4,8">
                                                    <FlyoutBase.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Edit"
                                                                            IconImageSource="note_edit.png"
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobDetailViewModel}}, Path=EditNoteCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                            <MenuFlyoutItem Text="Delete"
                                                                            IconImageSource="note_delete.png"
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JobDetailViewModel}}, Path=DeleteNoteCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                        </MenuFlyout>
                                                    </FlyoutBase.ContextFlyout>
                                                    <Label Text="{Binding Content}" FontSize="14" />
                                                    <HorizontalStackLayout Spacing="4">
                                                        <Label Text="{Binding CreatedByName}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                                        <Label Text="{Binding CreatedAt, Converter={StaticResource DateFormatConverter}}"
                                                               FontSize="11" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                                    </HorizontalStackLayout>
                                                    <Label FontSize="11" FontAttributes="Italic" IsVisible="{Binding IsEdited}"
                                                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="edited by " />
                                                                <Span Text="{Binding UpdatedByName}" />
                                                                <Span Text=" at " />
                                                                <Span Text="{Binding UpdatedAt, Converter={StaticResource DateFormatConverter}, ConverterParameter='MMM dd, yyyy h:mm tt'}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </VerticalStackLayout>
                                            </SwipeView>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </ScrollView>
            </controls:DataStateView.Body>
        </controls:DataStateView>

        <!-- Scrim (semi-transparent backdrop) -->
        <BoxView Color="#80000000" IsVisible="{Binding IsPartsPanelOpen}" InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ClosePartsPanelCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Slide-out parts panel (width clamped to the screen in OnSizeAllocated) -->
        <Frame x:Name="PartsPanel"
               BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
               CornerRadius="16" BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
               HorizontalOptions="End" VerticalOptions="Fill" Padding="0"
               WidthRequest="320" IsVisible="{Binding IsPartsPanelOpen}" HasShadow="True">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="16">
                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Text="✕" Style="{StaticResource GhostButton}" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                            Command="{Binding ClosePartsPanelCommand}" FontSize="18" Padding="0" WidthRequest="36" />
                    <Label Grid.Column="1" Text="{Binding PartsPanelTitle}" FontSize="18" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    <Label Grid.Column="2" Text="{Binding SelectedCount, StringFormat='{0} selected'}"
                           FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" VerticalTextAlignment="Center" />
                </Grid>

                <!-- Search -->
                <SearchBar Grid.Row="1" Placeholder="Search parts..." Text="{Binding NewItemSearchText}"
                           Margin="0,8,0,0" />

                <!-- Inventory list: category headers + checkbox items (searching also
                     matches category names; groups are forced open while searching) -->
                <CollectionView Grid.Row="2" ItemsSource="{Binding SelectableInventory}" SelectionMode="None"
                                ItemTemplate="{StaticResource PickerRowTemplates}"
                                Margin="0,8,0,0">
                    <CollectionView.EmptyView>
                        <Label Text="No parts found" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" Padding="0,16"
                               HorizontalTextAlignment="Center" />
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Custom item entry -->
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                    <Entry Placeholder="Custom item name..." Text="{Binding NewAdhocItemName}" />
                </Grid>

                <!-- OK button -->
                <Button Grid.Row="4" Text="{Binding SelectedCount, StringFormat='Add {0} Parts'}"
                        Command="{Binding ConfirmAddPartsCommand}" Margin="0,12,0,0" />
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
