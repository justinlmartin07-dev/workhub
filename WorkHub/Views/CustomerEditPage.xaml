<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkHub.ViewModels"
             xmlns:models="clr-namespace:WorkHub.Models"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:controls="clr-namespace:WorkHub.Controls"
             x:Class="WorkHub.Views.CustomerEditPage"
             x:DataType="vm:CustomerEditViewModel"
             x:Name="thisPage"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="24" HorizontalOptions="Fill">
            <Entry Placeholder="Name *" Text="{Binding Name}" ReturnType="Next" />

            <!-- Address -->
            <VerticalStackLayout Spacing="4">
                <Entry Placeholder="Street Address" Text="{Binding Street}" ReturnType="Next" />
                <!-- Address suggestions dropdown -->
                <CollectionView ItemsSource="{Binding AddressSuggestions}" IsVisible="{Binding ShowAddressSuggestions}"
                                SelectionMode="None" HeightRequest="150">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AddressSuggestionResponse">
                            <Grid Padding="8,6" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceCardDark}}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerEditViewModel}}, Path=SelectAddressSuggestionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout>
                                    <Label Text="{Binding MainText}" FontSize="14" />
                                    <Label Text="{Binding SecondaryText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="8">
                <Entry Placeholder="City" Text="{Binding City}" ReturnType="Next" />
                <Entry Grid.Column="1" Placeholder="State" Text="{Binding State}" ReturnType="Next" />
                <Entry Grid.Column="2" Placeholder="Zip" Text="{Binding Zip}" Keyboard="Numeric" ReturnType="Next" />
            </Grid>

            <!-- Phone Numbers -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Phone Numbers" Style="{StaticResource SectionHeading}" VerticalTextAlignment="Center" />
                <Button Grid.Column="1" Text="+ Add" Style="{StaticResource SecondaryButton}" Command="{Binding AddPhoneCommand}" />
            </Grid>
            <CollectionView ItemsSource="{Binding PhoneEntries}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContactEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4" Padding="0,2">
                            <Picker WidthRequest="{OnPlatform 92, WinUI=140}" ItemsSource="{Binding BindingContext.PhoneLabelOptions, Source={x:Reference thisPage}}"
                                    SelectedItem="{Binding Label}" />
                            <Entry Grid.Column="1" Placeholder="Phone number" Text="{Binding Value}" Keyboard="Telephone" />
                            <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0"
                                    Padding="6" VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 8" controls:TapFeedback.Enable="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.RemovePhoneCommand, Source={x:Reference thisPage}}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <!-- Material Symbols "close" -->
                                <shapes:Path Data="M256-200l-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"
                                             Fill="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                             Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Email Addresses -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Email Addresses" Style="{StaticResource SectionHeading}" VerticalTextAlignment="Center" />
                <Button Grid.Column="1" Text="+ Add" Style="{StaticResource SecondaryButton}" Command="{Binding AddEmailCommand}" />
            </Grid>
            <CollectionView ItemsSource="{Binding EmailEntries}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContactEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4" Padding="0,2">
                            <Picker WidthRequest="{OnPlatform 92, WinUI=140}" ItemsSource="{Binding BindingContext.EmailLabelOptions, Source={x:Reference thisPage}}"
                                    SelectedItem="{Binding Label}" />
                            <Entry Grid.Column="1" Placeholder="Email address" Text="{Binding Value}" Keyboard="Email" />
                            <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0"
                                    Padding="6" VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 8" controls:TapFeedback.Enable="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.RemoveEmailCommand, Source={x:Reference thisPage}}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <!-- Material Symbols "close" -->
                                <shapes:Path Data="M256-200l-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"
                                             Fill="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                             Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- People -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="People" Style="{StaticResource SectionHeading}" VerticalTextAlignment="Center" />
                <Button Grid.Column="1" Text="+ Add" Style="{StaticResource SecondaryButton}" Command="{Binding AddPersonCommand}" />
            </Grid>
            <CollectionView ItemsSource="{Binding PersonEntries}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PersonEntry">
                        <Border Padding="8" Margin="0,2" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,Auto" RowSpacing="4" ColumnSpacing="4">
                                <Entry Placeholder="Name" Text="{Binding Name}" />
                                <Entry Grid.Column="1" Placeholder="Role (e.g. Site Super)" Text="{Binding Role}" />
                                <Border Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0"
                                        Padding="6" VerticalOptions="Center"
                                        StrokeShape="RoundRectangle 8" controls:TapFeedback.Enable="True">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.RemovePersonCommand, Source={x:Reference thisPage}}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <!-- Material Symbols "close" -->
                                    <shapes:Path Data="M256-200l-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z"
                                                 Fill="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                                 Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                </Border>
                                <Entry Grid.Row="1" Placeholder="Phone" Text="{Binding Phone}" Keyboard="Telephone" />
                                <Entry Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Editor Placeholder="Notes" Text="{Binding Notes}" HeightRequest="120" />

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Cancel" Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
