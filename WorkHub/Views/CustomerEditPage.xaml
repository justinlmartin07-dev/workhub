<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkHub.ViewModels"
             xmlns:models="clr-namespace:WorkHub.Models"
             x:Class="WorkHub.Views.CustomerEditPage"
             x:DataType="vm:CustomerEditViewModel"
             x:Name="thisPage"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="24" HorizontalOptions="Fill">
            <Entry Placeholder="Name *" Text="{Binding Name}" ReturnType="Next" />

            <!-- Address -->
            <VerticalStackLayout Spacing="4">
                <Entry Placeholder="Street Address" Text="{Binding Street}" ReturnType="Next" />
                <!-- Address suggestions dropdown -->
                <CollectionView ItemsSource="{Binding AddressSuggestions}" IsVisible="{Binding ShowAddressSuggestions}"
                                SelectionMode="None" HeightRequest="150">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AddressSuggestionResponse">
                            <Grid Padding="8,6" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceCardDark}}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerEditViewModel}}, Path=SelectAddressSuggestionCommand}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout>
                                    <Label Text="{Binding MainText}" FontSize="14" />
                                    <Label Text="{Binding SecondaryText}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="2*,*,*" ColumnSpacing="8">
                <Entry Placeholder="City" Text="{Binding City}" ReturnType="Next" />
                <Entry Grid.Column="1" Placeholder="State" Text="{Binding State}" ReturnType="Next" />
                <Entry Grid.Column="2" Placeholder="Zip" Text="{Binding Zip}" Keyboard="Numeric" ReturnType="Next" />
            </Grid>

            <!-- Phone Numbers -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Phone Numbers" FontSize="14" FontAttributes="Bold" VerticalTextAlignment="Center" />
                <Button Grid.Column="1" Text="+ Add" BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" Command="{Binding AddPhoneCommand}" Padding="4" />
            </Grid>
            <CollectionView ItemsSource="{Binding PhoneEntries}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContactEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,2">
                            <Picker WidthRequest="130" ItemsSource="{Binding BindingContext.PhoneLabelOptions, Source={x:Reference thisPage}}"
                                    SelectedItem="{Binding Label}" />
                            <Entry Grid.Column="1" Placeholder="Phone number" Text="{Binding Value}" Keyboard="Telephone" />
                            <Button Grid.Column="2" Text="✕" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                    WidthRequest="40" Padding="0"
                                    Command="{Binding BindingContext.RemovePhoneCommand, Source={x:Reference thisPage}}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Email Addresses -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Email Addresses" FontSize="14" FontAttributes="Bold" VerticalTextAlignment="Center" />
                <Button Grid.Column="1" Text="+ Add" BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" Command="{Binding AddEmailCommand}" Padding="4" />
            </Grid>
            <CollectionView ItemsSource="{Binding EmailEntries}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContactEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,2">
                            <Picker WidthRequest="130" ItemsSource="{Binding BindingContext.EmailLabelOptions, Source={x:Reference thisPage}}"
                                    SelectedItem="{Binding Label}" />
                            <Entry Grid.Column="1" Placeholder="Email address" Text="{Binding Value}" Keyboard="Email" />
                            <Button Grid.Column="2" Text="✕" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                    WidthRequest="40" Padding="0"
                                    Command="{Binding BindingContext.RemoveEmailCommand, Source={x:Reference thisPage}}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Editor Placeholder="Notes" Text="{Binding Notes}" HeightRequest="120" />

            <Label Text="{Binding ErrorMessage}" TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" IsVisible="{Binding HasError}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Cancel" BackgroundColor="{StaticResource Gray200}"
                        TextColor="{StaticResource Gray900}" Command="{Binding CancelCommand}" />
                <Button Grid.Column="1" Text="Save" Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
