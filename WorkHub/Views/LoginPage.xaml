<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WorkHub.ViewModels"
             x:Class="WorkHub.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             Title="Login">
    <ScrollView>
        <VerticalStackLayout Padding="24,40" Spacing="16" VerticalOptions="Center" HorizontalOptions="Fill">
            <Image Source="logo.png" HeightRequest="160" WidthRequest="160" HorizontalOptions="Center" Margin="0,0,0,20" />

            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" ReturnType="Next" HorizontalOptions="Fill" />
            <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True" ReturnType="Done" HorizontalOptions="Fill" />

            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}" HorizontalTextAlignment="Center" />

            <Button Text="Sign In" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" HorizontalOptions="Fill" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
