<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ══════════════════════════════════════════════════════════
         WorkHub Theme — Navy accent, light/dark pairs
         Canonical pairs: every Light-mode color has a Dark sibling.
           Accent:  Primary    / PrimaryDark
           Danger:  Danger     / DangerDark
           Warning: Warning    / WarningDark
           Success: Success    / SuccessDark
           Info:    Info       / InfoDark
           Muted text: Gray500 (light) / Gray400 (dark)
           Subtle text: Gray400 (light) / Gray500 (dark)
           Surface:  SurfaceCardLight / SurfaceCardDark
           Borders:  SurfaceBorderLight / SurfaceBorderDark
           Inputs:   SurfaceInputLight / SurfaceInputDark
         Use AppThemeBinding at the call site to pick the right one.
         ══════════════════════════════════════════════════════════ -->

    <!-- Primary Accent — Navy Blue -->
    <Color x:Key="Primary">#0E4A89</Color>
    <Color x:Key="PrimaryDark">#4A8BD0</Color>
    <Color x:Key="PrimaryLight">#C9DCEF</Color>
    <Color x:Key="PrimaryMuted">#093D75</Color>

    <!-- Button feedback shades: light theme darkens on hover/press,
         dark theme lightens (matches platform conventions). -->
    <Color x:Key="PrimaryHover">#0C4078</Color>
    <Color x:Key="PrimaryPressed">#093463</Color>
    <Color x:Key="PrimaryDarkHover">#5E99D8</Color>
    <Color x:Key="PrimaryDarkPressed">#74A8DF</Color>

    <!-- Secondary — Slate blue tones -->
    <Color x:Key="Secondary">#1E293B</Color>
    <Color x:Key="SecondaryLight">#334155</Color>

    <!-- Surfaces -->
    <Color x:Key="SurfaceDark">#0F172A</Color>
    <Color x:Key="SurfaceCardDark">#1E293B</Color>
    <Color x:Key="SurfaceBorderDark">#334155</Color>
    <Color x:Key="SurfaceLight">#F8FAFC</Color>
    <Color x:Key="SurfaceCardLight">#FFFFFF</Color>
    <Color x:Key="SurfaceBorderLight">#E2E8F0</Color>
    <!-- Text input fill — sits between the card and border shades so the
         field reads as a control against either page or card background. -->
    <Color x:Key="SurfaceInputDark">#273449</Color>
    <Color x:Key="SurfaceInputLight">#F1F5F9</Color>

    <!-- Semantic Colors -->
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="DangerDark">#F87171</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningDark">#FBBF24</Color>
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="SuccessDark">#34D399</Color>
    <Color x:Key="Info">#3B82F6</Color>
    <Color x:Key="InfoDark">#60A5FA</Color>

    <!-- Neutrals -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#0F172A</Color>

    <Color x:Key="Gray50">#F8FAFC</Color>
    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray700">#334155</Color>
    <Color x:Key="Gray800">#1E293B</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <!-- Used by FloatingActionButton + the default Button style for dark-mode text -->
    <Color x:Key="PrimaryDarkText">#0F172A</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>